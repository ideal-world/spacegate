# 生产环境必须使用共享后端；以下服务名对应 Compose 内部 DNS。
# 凭据通过部署 Secret / 进程环境或被忽略的 .env.local 注入，禁止提交真实值。
HAI_CORE_ENV=production
HAI_CORE_LOGGING_LEVEL=info

# 必须私有注入 HAI_DB_PASSWORD；外部数据库可覆盖下列连接字段。
HAI_DB_TYPE=postgresql
HAI_DB_HOST=db
HAI_DB_PORT=5432
# db.database
# 约束：生产数据库名
HAI_DB_DATABASE='hai'
HAI_DB_USER=postgres

# 必须私有注入 HAI_CACHE_PASSWORD。
HAI_CACHE_TYPE=redis
HAI_CACHE_HOST=cache
HAI_CACHE_PORT=6379

# 必须私有注入 HAI_STORAGE_ACCESSKEYID / HAI_STORAGE_SECRETACCESSKEY。
HAI_STORAGE_TYPE=s3
HAI_STORAGE_BUCKET=hai
HAI_STORAGE_REGION=us-east-1
HAI_STORAGE_ENDPOINT=http://storage:9000
HAI_STORAGE_FORCEPATHSTYLE=true

# 必须私有注入 HAI_REACH_PROVIDERS 的真实 SMTP/SMS/API JSON（包含凭据）。
# 空数组有意让配置校验拒绝启动，生产不得沿用开发 console Provider。
HAI_REACH_PROVIDERS='[]'
