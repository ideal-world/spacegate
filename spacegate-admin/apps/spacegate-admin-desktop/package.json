{
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "name": "spacegate-admin-desktop",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "paraglide:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --watch",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "dev": "vite dev --host 127.0.0.1 --port 5176",
    "compile": "pnpm paraglide:compile && vite build",
    "build": "pnpm compile",
    "package": "pnpm tauri:build",
    "preview": "vite preview --host 127.0.0.1 --port 5176 --strictPort",
    "check": "pnpm typecheck",
    "typecheck": "pnpm paraglide:compile && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src vite.config.ts svelte.config.js",
    "lint:fix": "eslint src vite.config.ts svelte.config.js --fix",
    "test": "pnpm paraglide:compile && vitest run --passWithNoTests",
    "test:watch": "pnpm paraglide:compile && vitest",
    "clean": "rimraf dist .turbo src-tauri/target src/lib/paraglide",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@h-ai/api-client": "catalog:",
    "@h-ai/ui": "catalog:",
    "spacegate-admin-shared": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@h-ai/core": "catalog:",
    "@iconify-json/tabler": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-message-format": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "bits-ui": "catalog:",
    "daisyui": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "svelte-eslint-parser": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
