.login-page {
  padding-top: 80rpx;
}

.login-head {
  padding: 0 12rpx 30rpx;
}

.brand {
  font-size: 46rpx;
  font-weight: 700;
  color: #0f172a;
}

.brand-sub {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 25rpx;
}

.mode-row {
  display: flex;
  gap: 12rpx;
  margin: 8rpx 0 12rpx;
}

.mode {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 25rpx;
}

.mode-active {
  background: #dbeafe;
  color: #1d4ed8;
  font-weight: 600;
}

.login-submit {
  margin-top: 24rpx;
}

.login-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 12rpx;
}
