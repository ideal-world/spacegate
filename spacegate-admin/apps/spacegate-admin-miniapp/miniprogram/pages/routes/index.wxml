<view class="page">
  <view class="header">
    <view>
      <view class="title">{{labels.mini_nav_routes}}</view>
      <view class="subtitle">{{gateway || labels.mini_select_gateway}} · {{labels.mini_label_version}} {{version}}</view>
    </view>
    <view class="row">
      <view class="btn btn-ghost" bindtap="onBack">{{labels.mini_back}}</view>
      <view class="btn btn-ghost" bindtap="onRefresh">{{labels.mini_button_refresh}}</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="card error">{{error}}</view>

  <view class="card">
    <view wx:if="{{gatewayNames.length}}" class="field gateway-picker">
      <picker range="{{gatewayNames}}" value="{{gatewayIndex}}" bindchange="onGatewayChange">
        <view class="picker">{{gateway || labels.mini_select_gateway}}</view>
      </picker>
    </view>
    <view class="row">
      <view class="item-title">{{labels.mini_section_routes}}</view>
      <view class="btn btn-primary" bindtap="onStartCreate">{{labels.mini_button_create}}</view>
    </view>
    <view wx:if="{{routeRows.length}}">
      <view wx:for="{{routeRows}}" wx:key="name" class="list-item">
        <view class="row">
          <view class="item-title">{{item.name}}</view>
          <view class="btn" data-index="{{index}}" bindtap="onSelectRoute">{{labels.mini_button_edit}}</view>
        </view>
        <view class="item-meta">{{item.preview}}</view>
      </view>
    </view>
    <view wx:else class="muted route-empty">{{labels.mini_empty}}</view>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">{{labels.mini_label_route}}</text>
      <input class="input" value="{{routeName}}" bindinput="onRouteNameInput" placeholder="route-name" />
    </view>

    <view class="field">
      <text class="label">{{labels.mini_label_json}}</text>
      <textarea class="textarea textarea-tall" value="{{routeJson}}" bindinput="onRouteJsonInput" maxlength="-1" ></textarea>
    </view>

    <view class="field">
      <text class="label">{{labels.mini_label_plugins}}</text>
      <textarea class="textarea" value="{{pluginsJson}}" bindinput="onPluginsInput" maxlength="-1" placeholder="[]" ></textarea>
      <view class="muted hint">{{labels.mini_route_plugins_hint}}</view>
    </view>

    <view class="row">
      <view class="muted">{{labels.mini_label_version}}：{{version}}</view>
      <view class="row">
        <view wx:if="{{editingName}}" class="btn btn-danger" bindtap="onDelete">{{labels.mini_button_delete}}</view>
        <button class="btn btn-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">{{labels.mini_button_save}}</button>
      </view>
    </view>

    <view wx:if="{{editingName}}" class="rename-block">
      <view class="divider" ></view>
      <view class="label">{{labels.mini_label_new_name}}</view>
      <view class="row">
        <input class="input rename-input" value="{{renameName}}" bindinput="onRenameInput" placeholder="new-route-name" />
        <view class="btn" bindtap="onRename">{{labels.mini_button_rename}}</view>
      </view>
      <view class="muted hint">{{labels.mini_route_rename_hint}}</view>
    </view>
  </view>
  <view class="footer-space" ></view>
</view>
