<view class="page">
  <view class="header">
    <view>
      <view class="title">{{labels.mini_nav_instances}}</view>
      <view class="subtitle">{{labels.mini_label_version}}：{{version}}</view>
    </view>
    <view class="row">
      <view class="btn btn-ghost" bindtap="onBack">{{labels.mini_back}}</view>
      <view class="btn btn-ghost" bindtap="onRefresh">{{labels.mini_button_refresh}}</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="card error">{{error}}</view>

  <view class="card">
    <view class="item-title">{{labels.mini_section_health}}</view>
    <view wx:if="{{gatewayNames.length}}" class="field gateway-picker">
      <picker range="{{gatewayNames}}" value="{{gatewayIndex}}" bindchange="onGatewayChange">
        <view class="picker">{{gateway || labels.mini_select_gateway}}</view>
      </picker>
    </view>
    <view wx:if="{{instances.length}}">
      <view wx:for="{{instances}}" wx:key="name" class="list-item">
        <view class="row">
          <view class="item-title">{{item.name}}</view>
          <view class="chip {{item.online ? 'chip-ok' : 'chip-bad'}}">{{item.status}}</view>
        </view>
        <view class="toolbar instance-actions">
          <view class="btn" data-name="{{item.name}}" bindtap="onReloadGateway">{{labels.mini_button_reload_gateway}}</view>
          <view class="btn" data-name="{{item.name}}" bindtap="onReloadGlobal">{{labels.mini_button_reload_global}}</view>
          <view class="btn" data-name="{{item.name}}" bindtap="onReloadRoute">{{labels.mini_button_reload_route}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="muted">{{labels.mini_empty}}</view>
  </view>

  <view class="card">
    <view class="item-title">{{labels.mini_section_reload}}</view>
    <view class="field">
      <text class="label">{{labels.mini_label_route}}</text>
      <input class="input" value="{{routeName}}" bindinput="onRouteInput" placeholder="route-name" />
    </view>
    <view class="muted">{{labels.mini_reload_route_hint}}</view>
  </view>
  <view class="footer-space" ></view>
</view>
