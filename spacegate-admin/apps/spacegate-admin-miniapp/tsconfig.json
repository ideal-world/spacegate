{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["miniprogram/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "dist"]
}
