{
  "name": "spacegate-admin-app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "paraglide:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --watch",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "dev": "vite dev --host 127.0.0.1 --port 5175",
    "build": "pnpm paraglide:compile && vite build",
    "package": "pnpm cap:sync",
    "preview": "vite preview --host 127.0.0.1 --port 5175 --strictPort",
    "check": "pnpm typecheck",
    "typecheck": "pnpm paraglide:compile && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm paraglide:compile && vitest run --passWithNoTests",
    "test:watch": "pnpm paraglide:compile && vitest",
    "clean": "rimraf dist build android ios .turbo src/lib/paraglide",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "pnpm build && cap sync",
    "cap:sync:android": "pnpm build && cap sync android",
    "cap:sync:ios": "pnpm build && cap sync ios",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "cap:build:android:debug": "pnpm build && cap sync android && cd android && gradlew.bat assembleDebug",
    "cap:build:android:release": "pnpm build && cap sync android && cap build android --androidreleasetype APK",
    "cap:build:ios": "pnpm build && cap sync ios && cap build ios"
  },
  "dependencies": {
    "@h-ai/capacitor": "catalog:",
    "@h-ai/ui": "catalog:",
    "spacegate-admin-shared": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@aparajita/capacitor-secure-storage": "catalog:",
    "@capacitor/android": "catalog:",
    "@capacitor/app": "catalog:",
    "@capacitor/camera": "catalog:",
    "@capacitor/cli": "catalog:",
    "@capacitor/core": "catalog:",
    "@capacitor/device": "catalog:",
    "@capacitor/ios": "catalog:",
    "@capacitor/preferences": "catalog:",
    "@capacitor/push-notifications": "catalog:",
    "@capacitor/status-bar": "catalog:",
    "@h-ai/core": "catalog:",
    "@iconify-json/tabler": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-message-format": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "bits-ui": "catalog:",
    "daisyui": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "svelte-eslint-parser": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
