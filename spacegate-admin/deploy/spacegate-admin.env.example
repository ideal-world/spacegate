# SpaceGate Hai 管理面独立启动环境示例
# 复制为 deploy/spacegate-admin.env（已被 .gitignore 忽略），不要提交真实密钥。

# 运行环境。local/standalone 评估使用 development；生产请使用 hai deploy 并连接共享中间件。
HAI_CORE_ENV=development
HAI_CORE_LOGGING_LEVEL=info

# 首次启动管理员；已有用户时不会重设密码。
HAI_ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password

# 由 `node deploy/generate-transport-keyring.mjs` 生成；生产由 Secret Manager 注入。
HAI_CRYPTO_TRANSPORT_SERVERKEYRING={"activeKeyId":"local-v1","keys":{"local-v1":{"publicKey":"...","privateKey":"..."}}}

# 既有 Rust admin-server 与服务身份。生产只允许内网/HTTPS 可达。
HAI_SPACEGATE_ADMINBASEURL=http://host.docker.internal:9992
HAI_SPACEGATE_ADMINAK=replace-with-service-ak
HAI_SPACEGATE_ADMINSK=replace-with-service-sk
HAI_SPACEGATE_ALLOWINSECURE=false

# 既有 AI Gateway 管理接口（/v1/admin/...）。
HAI_SPACEGATE_AIGATEWAYBASEURL=http://host.docker.internal:18080

# 可选：微信小程序独立通道；不设置则完全不监听。
HAI_SERV_MINIAPP_PORT=3001

# Web 容器运行时 API Origin；同源反代时可改为公网 Origin。
PUBLIC_API_BASE=http://127.0.0.1:3000
